<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.PlaceholderView">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
    <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontTitle}" FontWeight="SemiBold"
               Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
    <TextBlock Text="Not ported yet — still available in the current app."
               FontSize="12" Foreground="{DynamicResource Text3}" HorizontalAlignment="Center"/>
  </StackPanel>
</UserControl>
