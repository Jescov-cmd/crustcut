<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.OptimizeView">

  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Optimize" Classes="pageTitle"/>
          <TextBlock Text="{Binding StatusText}" Classes="pageSubtitle"/>
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Search…"
                 Width="200" Height="28" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,26,20">
      <Border Classes="panel">
        <StackPanel>

          <!-- Column headers, so the switch column reads as a column rather than a
               floating control per row. -->
          <!-- Wrapped in the same Border.row the data rows use. Sitting outside it, the
               header went through different layout and its columns landed ~44px off. -->
          <Border Classes="row">
            <Grid ColumnDefinitions="*,120,58">
              <TextBlock Grid.Column="0" Text="Optimization" Classes="colHead"/>
              <TextBlock Grid.Column="1" Text="Category" Classes="colHead" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="On" Classes="colHead"
                         HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding VisibleRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,120,58">

                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                      <TextBlock Text="{Binding DisplayName}" Classes="key"/>
                      <TextBlock Text="{Binding Description}" Classes="sub"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                        <TextBlock Text="Needs restart" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Warn}"
                                   IsVisible="{Binding RequiresReboot}"/>
                        <TextBlock Text="Runs hotter" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding CausesHeat}"/>
                        <TextBlock Text="Caution" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text3}"
                                   IsVisible="{Binding HasOtherRisk}"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Left-aligned and muted: right-aligned bold white read as a value,
                         which it isn't — it's a tag. -->
                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11.5"
                               Foreground="{DynamicResource Text3}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,1,0,0"/>

                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsBusy}"
                                  Tag="{Binding}" Click="ToggleClick"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
