<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.OptimizeView">

  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Optimize" Classes="pageTitle"/>
          <TextBlock Text="{Binding StatusText}" Classes="pageSubtitle"/>
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Search…"
                 MinWidth="150" MaxWidth="260" Height="28" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,26,20">
      <Border Classes="panel">
        <!-- Grid, NOT StackPanel: Avalonia StackPanel measures children with unconstrained
             width, so the ItemsControl took its natural width and rows overflowed the
             panel at narrow window sizes (rows 653 wide inside a 607 panel, switches
             bleeding past the border). Grid passes the real width down, which also lets
             text wrapping engage. -->
        <Grid x:Name="PanelGrid" RowDefinitions="Auto,Auto">

          <!-- Column headers, wrapped in the same Border.row the data rows use so both go
               through identical layout and the columns align. -->
          <Border Grid.Row="0" Classes="row">
            <Grid ColumnDefinitions="*,120,72">
              <TextBlock Grid.Column="0" Text="Optimization" Classes="colHead"/>
              <TextBlock Grid.Column="1" Text="Category" Classes="colHead" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="On" Classes="colHead"
                         HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- Explicit width from the panel grid: the ItemsControl's internal
                     StackPanel measures items with INFINITE width (verified via layout
                     dump), so wrapping never engages and rows take natural width —
                     overflowing the panel at narrow sizes. Binding the row to a
                     width-constrained ancestor is what restores a finite measure. -->
                <Border Classes="row" Width="{Binding #PanelGrid.Bounds.Width}">
                  <Grid ColumnDefinitions="*,120,72">

                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                      <TextBlock Text="{Binding DisplayName}" Classes="key"/>
                      <TextBlock Text="{Binding Description}" Classes="sub"/>
                      <!-- Result line for one-shot actions ("DNS cache cleared."). -->
                      <TextBlock Text="{Binding OneShotStatus}" FontSize="10.5"
                                 Foreground="{DynamicResource Good}"
                                 IsVisible="{Binding OneShotStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                        <TextBlock Text="Needs restart" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Warn}"
                                   IsVisible="{Binding RequiresReboot}"/>
                        <TextBlock Text="Runs hotter" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding CausesHeat}"/>
                        <TextBlock Text="Caution" FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text3}"
                                   IsVisible="{Binding HasOtherRisk}"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Left-aligned and muted: right-aligned bold white read as a value,
                         which it isn't — it's a tag. -->
                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11.5"
                               Foreground="{DynamicResource Text3}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,1,0,0"/>

                    <!-- Persistent settings get a toggle; one-time actions get RUN — a
                         switch for "flush a cache" always snapped back off and read as
                         broken, because there is no state for it to hold. -->
                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsBusy}"
                                  IsVisible="{Binding IsToggle}"
                                  Tag="{Binding}" Click="ToggleClick"/>
                    <Button Grid.Column="2" Content="RUN" Classes="secondary"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding IsOneShot}"
                            Tag="{Binding}" Click="RunClick"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </Grid>
      </Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
