<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.CleanupView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="20,0,20,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Cleanup" Classes="pageTitle" Margin="0,16,0,10"/>
      <TextBlock Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Text2}" Margin="0,0,0,12"/>
      <Button Content="SCAN FOR UNNECESSARY APPS" Classes="primary" Margin="0,0,0,16" HorizontalAlignment="Left"
              IsEnabled="{Binding !IsScanning}"
              Click="ScanClick"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid x:Name="PanelGrid">
      <StackPanel>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Width="{Binding #PanelGrid.Bounds.Width}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text0}"/>
                    <TextBlock Text="{Binding RiskNote}" FontSize="11"
                               Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                               Margin="0,3,12,0"
                               IsVisible="{Binding RiskNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <Button Grid.Column="1" Content="DISABLE" Classes="secondary" Margin="0,0,8,0" IsEnabled="{Binding !IsBusy}" Tag="{Binding}" Click="DisableClick"/>

                  <Button Grid.Column="2" Content="REMOVE" Classes="danger" IsEnabled="{Binding CanUninstall}" Tag="{Binding}" Click="UninstallClick"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="DESKTOP PROGRAMS" Classes="colHead" Margin="0,14,0,8"
                   IsVisible="{Binding HasDesktopItems}"/>
        <ItemsControl ItemsSource="{Binding DesktopItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Width="{Binding #PanelGrid.Bounds.Width}">
                <StackPanel>
                  <TextBlock Text="{Binding ProgramName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}"/>
                  <TextBlock Text="{Binding Publisher}" FontSize="11"
                             Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
