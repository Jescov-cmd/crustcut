<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.CleanupView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="20,0,20,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Cleanup" Classes="pageTitle" Margin="0,16,0,10"/>
      <TextBlock Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Text2}" Margin="0,0,0,12"/>
      <Button Content="SCAN FOR UNNECESSARY APPS" Classes="primary" Margin="0,0,0,16" HorizontalAlignment="Left"
              IsEnabled="{Binding !IsScanning}"
              Click="ScanClick"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid x:Name="PanelGrid">
      <StackPanel>

        <!-- Startup programs: what launches with Windows is the #1 reason a PC feels
             slow. Toggles write the same marks Task Manager uses — nothing is deleted,
             either app can undo the other. -->
        <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource Hairline}"
                BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,16"
                IsVisible="{Binding HasStartupSupport}">
          <StackPanel Spacing="6">
            <TextBlock Text="STARTS WITH WINDOWS" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text3}"/>
            <TextBlock Text="Everything that launches itself at boot. Fewer of these = a faster startup and more free memory all day. Switching one off doesn't uninstall anything — it just stops the auto-launch, same as Task Manager, and you can switch it back any time."
                       FontSize="11.5" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding StartupApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,90,Auto" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Text1}"/>
                      <TextBlock Text="{Binding Command}" FontSize="10.5"
                                 Foreground="{DynamicResource Text3}"
                                 TextTrimming="CharacterEllipsis" Margin="0,1,12,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" FontSize="10.5"
                               Foreground="{DynamicResource Text3}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" MinWidth="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                  Click="StartupToggleClick"
                                  Tag="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Width="{Binding #PanelGrid.Bounds.Width}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text0}"/>
                    <TextBlock Text="{Binding RiskNote}" FontSize="11"
                               Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                               Margin="0,3,12,0"
                               IsVisible="{Binding RiskNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <Button Grid.Column="1" Content="DISABLE" Classes="secondary" Margin="0,0,8,0" IsEnabled="{Binding !IsBusy}" Tag="{Binding}" Click="DisableClick"/>

                  <Button Grid.Column="2" Content="REMOVE" Classes="danger" IsEnabled="{Binding CanUninstall}" Tag="{Binding}" Click="UninstallClick"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="DESKTOP PROGRAMS" Classes="colHead" Margin="0,14,0,8"
                   IsVisible="{Binding HasDesktopItems}"/>
        <ItemsControl ItemsSource="{Binding DesktopItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Width="{Binding #PanelGrid.Bounds.Width}">
                <StackPanel>
                  <TextBlock Text="{Binding ProgramName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}"/>
                  <TextBlock Text="{Binding Publisher}" FontSize="11"
                             Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
