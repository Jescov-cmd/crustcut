<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Crustcut.Presentation;assembly=Crustcut.Presentation"
             x:Class="Crustcut.App.Views.FansView">

  <!-- Windows Settings layout: one setting per card, icon · title + description · control. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
    <!-- Grid + bound width, as on What's new: a StackPanel measured inside a ScrollViewer
         can take its text's natural width and run past the right edge. -->
    <Grid x:Name="PanelGrid">
    <StackPanel Width="{Binding #PanelGrid.Bounds.Width}" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Fans" Classes="pageTitle" Margin="0,22,0,6"/>
      <TextBlock Classes="pageSubtitle" Margin="0,0,0,18"
                 Text="Fans never stop, anything over 90 °C means full speed, and your motherboard takes back control when Crustcut closes. Your graphics card runs its own fans."/>

      <Border Classes="card" IsVisible="{Binding !IsSupported}">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="cardIcon" Text="&#xE7BA;"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="No controllable fans found" Classes="key"/>
            <TextBlock Classes="sub"
                       Text="Another program is probably holding the fan chip (lighting software, a vendor control panel or a hardware monitor). Close it and control shows up here within a minute."/>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel IsVisible="{Binding IsSupported}">
        <!-- Live temperature: the number people come here for, first and big. -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="cardIcon" Text="&#xE9CA;"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="CPU temperature" Classes="key"/>
              <TextBlock Classes="sub" Text="{Binding DutyText, StringFormat='Averaged over a few seconds · fans at {0}'}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Classes="big" Text="{Binding TempText}" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Classes="card" Margin="0,0,0,4"
                Background="#1A1600" BorderBrush="#4D4200"
                IsVisible="{Binding ConflictSuspected}">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="cardIcon" Text="&#xE7BA;" Foreground="{DynamicResource Warn}"/>
            <TextBlock Grid.Column="1" Classes="sub" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"
                       Text="Another program keeps overriding the fans. If you use lighting or vendor software, turn off its fan control. The rest of it keeps working."/>
          </Grid>
        </Border>

        <TextBlock Text="Control" Classes="section"/>

        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="cardIcon" Text="&#xE945;"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Fan control" Classes="key"/>
              <TextBlock Text="{Binding StatusText}" Classes="sub"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center"
                          IsChecked="{Binding Enabled, Mode=OneWay}" Click="ToggleClick"/>
          </Grid>
        </Border>

        <Border Classes="card" IsEnabled="{Binding Enabled}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="cardIcon" Text="&#xE9E9;"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Mode" Classes="key"/>
              <TextBlock Classes="sub" Text="Auto follows load and temperature: quiet for light work, faster when the PC is busy or hot."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <ToggleButton Classes="protect" Content="Auto"
                            IsChecked="{Binding IsAuto, Mode=OneWay}" Click="AutoClick"/>
              <ToggleButton Classes="protect" Content="Silent"
                            IsChecked="{Binding IsSilent, Mode=OneWay}" Click="SilentClick"/>
              <ToggleButton Classes="protect" Content="Balanced"
                            IsChecked="{Binding IsBalanced, Mode=OneWay}" Click="BalancedClick"/>
              <ToggleButton Classes="protect" Content="Max"
                            ToolTip.Tip="Performance curve: loudest, coolest."
                            IsChecked="{Binding IsPerformance, Mode=OneWay}" Click="PerformanceClick"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Heat-based power management: boost, not voltage. Voltage needs a kernel driver
             and can crash or corrupt; boost is Windows' own supported lever. -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Classes="cardIcon" Text="&#xE9F5;"/>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Cool-down assist" Classes="key"/>
                <TextBlock Classes="sub"
                           Text="If the CPU stays above 85 °C for 20 seconds, turbo boost is trimmed so it can cool. Full power returns after a cool minute."/>
              </StackPanel>
              <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Center"
                            IsChecked="{Binding GovernorEnabled, Mode=TwoWay}"/>
            </Grid>
            <TextBlock Classes="sub" Margin="34,0,0,0" Foreground="{DynamicResource AccentWheat}"
                       IsVisible="{Binding BoostTrimmed}"
                       Text="Cooling down now. Boost comes back once the CPU has been cool for a minute."/>
          </StackPanel>
        </Border>

        <TextBlock Text="Fans" Classes="section"/>

        <Border Classes="panel" Padding="16,4,16,8">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Fans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto,72,Auto">
                      <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Classes="key"/>
                        <TextBlock Text="{Binding Note}" Classes="sub"
                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Rpm}" Classes="value"/>
                      <TextBlock Grid.Column="2" Text="{Binding Duty}" Classes="value"
                                 Foreground="{DynamicResource Text2}"/>
                      <!-- Only while fixing readings: tachometers report pulses, and fans
                           differ in pulses per turn, so a reading can be half or double. -->
                      <Button Grid.Column="3" Content="Halve / double" Margin="12,0,0,0"
                              IsVisible="{Binding $parent[ItemsControl].((vm:FansViewModel)DataContext).FixingReadings}"
                              Tag="{Binding Name}" Click="RpmScaleClick"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
              <TextBlock Grid.Column="0" Classes="sub" VerticalAlignment="Center"
                         Text="{Binding CalibrationText}"/>
              <ToggleButton Grid.Column="1" Classes="protect" Content="Fix readings" Margin="0,0,8,0"
                            ToolTip.Tip="Shows a button on each fan to halve or double its speed reading, for when it doesn't match your BIOS."
                            IsChecked="{Binding FixingReadings, Mode=TwoWay}"/>
              <Button Grid.Column="2" Content="Calibrate" Click="CalibrateClick"
                      IsEnabled="{Binding !IsCalibrating}"
                      ToolTip.Tip="Measures how slowly each of your fans can spin without stopping, then uses that as the minimum. Takes about a minute; fans speed up and slow down during it."/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
