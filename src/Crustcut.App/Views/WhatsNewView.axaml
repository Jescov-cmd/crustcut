<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.WhatsNewView">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="What's new" Classes="pageTitle" Margin="0,16,0,10"/>
      <TextBlock Text="Every release, newest first — features and fixes alike."
                 FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,0,16"/>

      <ItemsControl x:Name="ReleaseList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource SurfaceCard}" CornerRadius="4"
                    Padding="18,14" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                             FontSize="13" FontWeight="Bold"
                             Foreground="{DynamicResource AccentWheat}"/>
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}"/>
                  <TextBlock Text="{Binding When}" FontSize="11"
                             Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="14,*" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="▪" FontSize="10"
                                   Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                   Foreground="{DynamicResource Text1}" TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
