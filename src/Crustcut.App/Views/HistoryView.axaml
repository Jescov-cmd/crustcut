<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.HistoryView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="20,0,20,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="History" Classes="pageTitle" Margin="0,16,0,10"/>
      <TextBlock Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Text2}" Margin="0,0,0,14"/>

      <!-- The engine's own diary: automatic cleanups (with names), fan decisions,
           Cool-Down Assist trims, upgrade heals. Everything Crustcut does on its own
           should be visible here — invisible background behaviour is how this app's
           worst bugs stayed hidden. -->
      <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource Hairline}"
              BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,14">
        <StackPanel Spacing="6">
          <TextBlock Text="WHAT CRUSTCUT DID RECENTLY (automatic actions)" FontSize="10.5"
                     FontWeight="SemiBold" Foreground="{DynamicResource Text3}"/>
          <ItemsControl x:Name="ActivityList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="11"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                           Margin="0,1,0,0"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5"
                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding AppliedAtUtc, StringFormat='{}{0:MMM d HH:mm}'}"
                           FontSize="11"
                           Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
