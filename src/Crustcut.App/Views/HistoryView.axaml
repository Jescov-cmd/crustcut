<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.HistoryView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="28,0,28,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="History" Classes="pageTitle" Margin="0,22,0,8"/>
      <TextBlock Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Text2}" Margin="0,0,0,14"/>

      <!-- The engine's own diary: automatic cleanups (with names), fan decisions,
           Cool-Down Assist trims, upgrade heals. Everything Crustcut does on its own
           should be visible here — invisible background behaviour is how this app's
           worst bugs stayed hidden. -->
      <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource Hairline}"
              BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,14">
        <StackPanel Spacing="6">
          <TextBlock Text="WHAT CRUSTCUT DID RECENTLY (automatic actions)" FontSize="10.5"
                     FontWeight="SemiBold" Foreground="{DynamicResource Text3}"/>
          <ItemsControl x:Name="ActivityList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="11"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                           Margin="0,1,0,0"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Virtualized: 260+ entries built all at once cost ~16 MB and every one of them was
         re-styled on each visit. Same rules as the Memory list: ScrollViewer INSIDE the
         template, ItemsPanel template-bound, rows pinned to the list width. -->
    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.Template>
        <ControlTemplate>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="row"
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsPresenter, Tree=Visual}}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5"
                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding AppliedAtUtc, StringFormat='{}{0:MMM d HH:mm}'}"
                           FontSize="11"
                           Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
