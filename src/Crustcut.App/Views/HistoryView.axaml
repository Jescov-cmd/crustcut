<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.HistoryView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource FontLabel}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="HISTORY" Classes="label" Height="56" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Text2}" Margin="0,0,0,14"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5"
                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding AppliedAtUtc, StringFormat='{}{0:MMM d HH:mm}'}"
                           FontSize="11"
                           Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
