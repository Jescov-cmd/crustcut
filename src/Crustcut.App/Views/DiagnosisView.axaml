<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:Crustcut.App.Controls"
             x:Class="Crustcut.App.Views.DiagnosisView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="28,0,28,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Diagnosis" Classes="pageTitle" Margin="0,22,0,8"/>
      <TextBlock Text="{Binding Status}" FontSize="12"
                 Foreground="{DynamicResource Text2}" Margin="0,0,0,14" TextWrapping="Wrap"/>
      <Button Content="Run scan" Classes="primary" Margin="0,0,0,16" HorizontalAlignment="Left"
              IsEnabled="{Binding !IsScanning}"
              Click="ScanClick"/>
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <cc:FitWidth Padding="0,0,18,0">
      <Grid x:Name="PanelGrid">
      <ItemsControl ItemsSource="{Binding Findings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="row">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border CornerRadius="2" Padding="8,2" Background="#22FF6B6B"
                          IsVisible="{Binding IsProblem}">
                    <TextBlock Text="Problem" FontSize="9" Foreground="{DynamicResource Danger}"/>
                  </Border>
                  <Border CornerRadius="2" Padding="8,2" Background="#22FFB84D"
                          IsVisible="{Binding IsWarning}">
                    <TextBlock Text="Warning" FontSize="9" Foreground="{DynamicResource Warn}"/>
                  </Border>
                  <Border CornerRadius="2" Padding="8,2" Background="#223ECF8E"
                          IsVisible="{Binding IsPassed}">
                    <TextBlock Text="OK" FontSize="9" Foreground="{DynamicResource Good}"/>
                  </Border>
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                           Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                           Margin="0,7,0,0"/>

                <TextBlock Text="{Binding FixSuggestion}" FontSize="11.5"
                           Foreground="{DynamicResource AccentWheat}" TextWrapping="Wrap"
                           Margin="0,6,0,0" IsVisible="{Binding HasFix}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
      </cc:FitWidth>
  </ScrollViewer>
  </DockPanel>
</UserControl>
