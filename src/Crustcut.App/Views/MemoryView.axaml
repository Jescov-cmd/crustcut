<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.MemoryView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="28,0,28,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Memory" Classes="pageTitle" Margin="0,22,0,8"/>
      <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,0,14"
                 TextWrapping="Wrap"
                 Text="Give the apps you care about more CPU priority, cap how much memory an app may keep, and protect favourites from cleanups. Anything with an open window is protected automatically."/>

      <!-- WrapPanel, not a horizontal StackPanel: five buttons don't fit at the minimum
           window width, and a StackPanel just clips the overflow off the right edge. -->
      <WrapPanel Margin="0,0,0,16">
        <WrapPanel.Styles>
          <Style Selector="Button"><Setter Property="Margin" Value="0,0,9,8"/></Style>
        </WrapPanel.Styles>
        <Button x:Name="CleanNowButton" Content="Free up RAM" Classes="primary" Click="CleanNowClick"
                ToolTip.Tip="Releases memory held by idle background programs. Apps you're using are left alone."/>
        <Button x:Name="DeepCleanButton" Content="Deep clean" Classes="secondary" Click="DeepCleanClick"
                ToolTip.Tip="Bigger cleanup: minimised apps and small background programs included, plus Windows' own caches. Minimised apps wake a moment slower afterwards. On-screen, focused and PROTECT-ed apps are never touched."/>
        <Button Content="Recommended limits" Classes="secondary" Click="RecommendedLimitsClick"
                ToolTip.Tip="Measures what each running BACKGROUND app uses and caps it with 50% headroom. Apps with a window are skipped — capping one can make it render badly. Games are never capped."/>
        <Button Content="Scan running apps" Classes="secondary" Click="RescanClick"/>
        <Button Content="Recommended for my games" Classes="secondary" Click="RecommendedClick"/>
      </WrapPanel>


      <TextBlock x:Name="LastCleanupText" FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource Text3}" Margin="0,0,0,4"/>
      <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource Text3}" Margin="0,0,0,12"/>

      <!-- Live visibility beats cleaning: on a RAM-starved machine the real fix is
           closing the right app, and this is how you find it. -->
      <Border Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource Hairline}"
              BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,14"
              MaxWidth="560" HorizontalAlignment="Left">
        <StackPanel Spacing="6">
          <TextBlock Text="Using the most memory right now" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text3}"/>
          <ItemsControl ItemsSource="{Binding TopMemory}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,110,90" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                             Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="10.5"
                             Foreground="{DynamicResource Text3}" VerticalAlignment="Center"
                             HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="{Binding UsageMb}" FontSize="12"
                             FontFeatures="+tnum"
                             Foreground="{DynamicResource Text0}" HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Virtualized: only the rows on screen exist. The list used to realise every rule —
         75 on the user's machine, ~150 dropdowns — so each visit to this tab re-styled
         them all and froze the UI for about a second. The ScrollViewer lives INSIDE the
         ItemsControl's template; wrapped around it from outside, the panel is measured
         with infinite height and virtualization silently switches off. -->
    <ItemsControl ItemsSource="{Binding Rules}">
      <ItemsControl.Template>
        <ControlTemplate>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <!-- ItemsPanel MUST be template-bound: without it the presenter quietly uses a
                 plain StackPanel, every row gets built, and the VirtualizingStackPanel below
                 is never used (it wasn't — 153 dropdowns, +42 MB, 0.75 s first open). -->
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Pinned to the list's width: a long exe path otherwise measures the row a few
                 px wider than the list, pushing the ✕ under the scrollbar. -->
            <Border Classes="row"
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ItemsPresenter, Tree=Visual}}">
              <Grid ColumnDefinitions="*,150,114,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}"/>
                  <TextBlock Text="{Binding ExePath}" FontSize="10.5"
                             Foreground="{DynamicResource Text3}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,12,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" Width="140" Height="26" Margin="0,0,10,0"
                          VerticalAlignment="Center" FontSize="12"
                          ItemsSource="{Binding $parent[UserControl].DataContext.PriorityLevels}"
                          SelectedItem="{Binding Priority, Mode=TwoWay}"
                          Tag="{Binding}"
                          SelectionChanged="PriorityChanged"/>

                <!-- Hard RAM cap, Edge-resource-controls style: the app keeps running but
                     can't hold more memory than this — the excess pages out instead. -->
                <ComboBox Grid.Column="2" Width="104" Height="26" Margin="0,0,10,0"
                          VerticalAlignment="Center" FontSize="12"
                          ItemsSource="{Binding $parent[UserControl].DataContext.MemoryLimitOptions}"
                          SelectedItem="{Binding MemoryLimit, Mode=TwoWay}"
                          ToolTip.Tip="Most memory this app may keep in RAM, per process. Anything above spills to disk. Careful with apps you actually look at: capping a window's memory can make it render badly (black boxes, blurry text). Crustcut only auto-caps background apps for that reason."
                          Tag="{Binding}"
                          SelectionChanged="MemoryLimitChanged"/>

                <!-- Click handler persists — a checkbox that only flips the in-memory
                     property forgets itself on the next visit. -->
                <ToggleButton Grid.Column="3" Classes="protect soft" Content="Protect"
                          Margin="0,0,10,0" VerticalAlignment="Center"
                          IsChecked="{Binding ProtectFromRamCleanup, Mode=TwoWay}"
                          ToolTip.Tip="Never trim this app's memory"
                          Tag="{Binding}" Click="ProtectChanged"/>

                <!-- Same dark fill and border as the dropdown beside it, same 26px height
                     as the pill — one row, one control language. -->
                <Button Grid.Column="4" Content="✕"
                        MinHeight="26" Height="26" MinWidth="32" Padding="0"
                        Background="#1F1F1F" BorderBrush="#4A4A4A"
                        Foreground="{DynamicResource Danger}" FontSize="12"
                        VerticalAlignment="Center" ToolTip.Tip="Remove this rule"
                        Tag="{Binding}" Click="RemoveClick"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
