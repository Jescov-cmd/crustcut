<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.MemoryView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="20,0,20,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Memory" Classes="pageTitle" Margin="0,16,0,10"/>
      <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,0,14"
                 TextWrapping="Wrap"
                 Text="Give the apps you care about more CPU priority, and protect them from memory cleanups. Anything with an open window is protected automatically."/>

      <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,16">
        <Button Content="Scan running apps" Classes="primary"   Click="RescanClick"/>
        <Button Content="Recommended for my games" Classes="secondary" Click="RecommendedClick"/>
      </StackPanel>

      <TextBlock x:Name="StatusText" FontSize="11.5"
                 Foreground="{DynamicResource Text3}" Margin="0,0,0,12"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <ItemsControl ItemsSource="{Binding Rules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="row">
              <Grid ColumnDefinitions="*,140,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}"/>
                  <TextBlock Text="{Binding ExePath}" FontSize="10.5"
                             Foreground="{DynamicResource Text3}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,12,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" Width="140" Height="28" Margin="0,0,12,0"
                          VerticalAlignment="Center" FontSize="12"
                          ItemsSource="{Binding $parent[UserControl].DataContext.PriorityLevels}"
                          SelectedItem="{Binding Priority, Mode=TwoWay}"
                          Tag="{Binding}"
                          SelectionChanged="PriorityChanged"/>

                <!-- Click handler persists — a checkbox that only flips the in-memory
                     property forgets itself on the next visit. -->
                <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                          IsChecked="{Binding ProtectFromRamCleanup, Mode=TwoWay}"
                          Content="Protect"
                          Foreground="{DynamicResource Text2}" FontSize="11"
                          Tag="{Binding}"
                          Click="ProtectChanged"/>

                <Button Grid.Column="3" Content="✕" Classes="danger"
                        MinHeight="24" Height="24" Padding="8,0" FontSize="11"
                        VerticalAlignment="Center" ToolTip.Tip="Remove this rule"
                        Tag="{Binding}" Click="RemoveClick"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
