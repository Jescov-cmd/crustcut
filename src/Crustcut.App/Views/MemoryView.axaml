<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.MemoryView">

  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    </UserControl.Styles>

  <DockPanel Margin="20,0,20,16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Memory" Classes="pageTitle" Margin="0,16,0,10"/>
      <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,0,0,14"
                 TextWrapping="Wrap"
                 Text="Give the apps you care about more CPU priority, cap how much memory an app may keep, and protect favourites from cleanups. Anything with an open window is protected automatically."/>

      <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,16">
        <Button x:Name="CleanNowButton" Content="FREE UP RAM" Classes="primary" Click="CleanNowClick"
                ToolTip.Tip="Releases memory held by idle background programs. Apps you're using are left alone."/>
        <Button x:Name="DeepCleanButton" Content="DEEP CLEAN" Classes="secondary" Click="DeepCleanClick"
                ToolTip.Tip="Bigger cleanup: minimized apps and small background programs included. Minimized apps wake a moment slower afterwards. On-screen, focused and PROTECT-ed apps are never touched."/>
        <Button Content="RECOMMENDED LIMITS" Classes="secondary" Click="RecommendedLimitsClick"
                ToolTip.Tip="Measures what each running app uses and caps it with ~25% headroom — normal use unaffected, runaway growth stopped. Games are never capped."/>
        <Button Content="SCAN RUNNING APPS" Classes="secondary" Click="RescanClick"/>
        <Button Content="RECOMMENDED FOR MY GAMES" Classes="secondary" Click="RecommendedClick"/>
      </StackPanel>

      <TextBlock x:Name="LastCleanupText" FontSize="11.5"
                 Foreground="{DynamicResource Text3}" Margin="0,0,0,4"/>
      <TextBlock x:Name="StatusText" FontSize="11.5"
                 Foreground="{DynamicResource Text3}" Margin="0,0,0,12"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <Grid x:Name="PanelGrid">
      <ItemsControl ItemsSource="{Binding Rules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="row" Width="{Binding #PanelGrid.Bounds.Width}">
              <Grid ColumnDefinitions="*,140,104,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text0}"/>
                  <TextBlock Text="{Binding ExePath}" FontSize="10.5"
                             Foreground="{DynamicResource Text3}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,12,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" Width="140" Height="26" Margin="0,0,10,0"
                          VerticalAlignment="Center" FontSize="12"
                          ItemsSource="{Binding $parent[UserControl].DataContext.PriorityLevels}"
                          SelectedItem="{Binding Priority, Mode=TwoWay}"
                          Tag="{Binding}"
                          SelectionChanged="PriorityChanged"/>

                <!-- Hard RAM cap, Edge-resource-controls style: the app keeps running but
                     can't hold more memory than this — the excess pages out instead. -->
                <ComboBox Grid.Column="2" Width="104" Height="26" Margin="0,0,10,0"
                          VerticalAlignment="Center" FontSize="12"
                          ItemsSource="{Binding $parent[UserControl].DataContext.MemoryLimitOptions}"
                          SelectedItem="{Binding MemoryLimit, Mode=TwoWay}"
                          ToolTip.Tip="Most memory this app may keep in RAM, per process. Anything above spills to disk — too low a cap can slow the app. Multi-process apps (browsers) get the cap per process, not in total."
                          Tag="{Binding}"
                          SelectionChanged="MemoryLimitChanged"/>

                <!-- Click handler persists — a checkbox that only flips the in-memory
                     property forgets itself on the next visit. -->
                <ToggleButton Grid.Column="3" Classes="protect" Content="PROTECT"
                          Margin="0,0,10,0" VerticalAlignment="Center"
                          IsChecked="{Binding ProtectFromRamCleanup, Mode=TwoWay}"
                          ToolTip.Tip="Never trim this app's memory"
                          Tag="{Binding}" Click="ProtectChanged"/>

                <!-- Same dark fill and border as the dropdown beside it, same 26px height
                     as the pill — one row, one control language. -->
                <Button Grid.Column="4" Content="✕"
                        MinHeight="26" Height="26" MinWidth="32" Padding="0"
                        Background="#1F1F1F" BorderBrush="#4A4A4A"
                        Foreground="{DynamicResource Danger}" FontSize="12"
                        VerticalAlignment="Center" ToolTip.Tip="Remove this rule"
                        Tag="{Binding}" Click="RemoveClick"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
