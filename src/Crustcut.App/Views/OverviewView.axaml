<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Crustcut.App.Controls"
             x:Class="Crustcut.App.Views.OverviewView">

  <UserControl.Styles>
    <!-- Dense settings-table rows separated by hairlines, the way a control panel lists
         things. No cards, no shadows, no rounding. -->
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,9"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SurfacePanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="14,10,14,12"/>
    </Style>
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Tabular numerals: values line up column-wise as they tick. -->
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Page header + toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hairline}"
            BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="System overview" FontSize="15" FontWeight="Bold"
                     Foreground="{DynamicResource Text0}"/>
          <TextBlock Text="{Binding BoostScoreSubtitle}" FontSize="11.5"
                     Foreground="{DynamicResource Text2}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button Content="See what changed" Height="28" Padding="12,0" CornerRadius="3"
                  Background="Transparent" BorderThickness="1"
                  BorderBrush="{DynamicResource Hairline}"
                  Foreground="{DynamicResource Text1}" FontSize="12" Cursor="Hand"/>
          <Button Content="Optimize now" Height="28" Padding="14,0" CornerRadius="3"
                  Background="{DynamicResource AccentWheat}" Foreground="#1A1206"
                  BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
      <StackPanel Spacing="16">

        <Grid ColumnDefinitions="*,16,*">

          <!-- ── Live readouts ── -->
          <Border Grid.Column="0" Classes="panel">
            <StackPanel>
              <TextBlock Text="LIVE" Classes="panelTitle"/>

              <Border Classes="row">
                <Grid ColumnDefinitions="*,74,92">
                  <TextBlock Grid.Column="0" Text="Processor" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value"
                             Text="{Binding CpuPercent, StringFormat={}{0:F0}%}"/>
                  <c:Sparkline Grid.Column="2" Height="18" Margin="12,0,0,0"
                               Maximum="100" Values="{Binding CpuHistory}"/>
                </Grid>
              </Border>

              <Border Classes="row">
                <Grid ColumnDefinitions="*,74,92">
                  <TextBlock Grid.Column="0" Text="Memory" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value"
                             Text="{Binding RamPercent, StringFormat={}{0:F0}%}"/>
                  <c:Sparkline Grid.Column="2" Height="18" Margin="12,0,0,0"
                               Maximum="100" Values="{Binding RamHistory}"/>
                </Grid>
              </Border>

              <Border Classes="row">
                <Grid ColumnDefinitions="*,74,92">
                  <TextBlock Grid.Column="0" Text="Graphics" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value"
                             Text="{Binding GpuPercent, StringFormat={}{0:F0}%}"/>
                  <c:Sparkline Grid.Column="2" Height="18" Margin="12,0,0,0"
                               Maximum="100" Values="{Binding GpuHistory}"/>
                </Grid>
              </Border>

              <Border Classes="row" BorderThickness="0">
                <Grid ColumnDefinitions="*,74,92">
                  <TextBlock Grid.Column="0" Text="Network" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding NetworkText}"/>
                  <c:Sparkline Grid.Column="2" Height="18" Margin="12,0,0,0"
                               Values="{Binding NetHistory}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- ── Status ── -->
          <Border Grid.Column="2" Classes="panel">
            <StackPanel>
              <TextBlock Text="STATUS" Classes="panelTitle"/>

              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Optimization score" Classes="key"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                    <TextBlock Classes="value" Text="{Binding BoostScore}"
                               Foreground="{DynamicResource AccentWheat}"/>
                    <TextBlock Classes="value" Text="/ 100"
                               Foreground="{DynamicResource Text3}"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Rating" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding BoostScoreTier}"/>
                </Grid>
              </Border>

              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Active profile" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value"
                             Text="{Binding ActiveProfileName, TargetNullValue=None}"/>
                </Grid>
              </Border>

              <Border Classes="row" BorderThickness="0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Sessions recorded" Classes="key"/>
                  <TextBlock Grid.Column="1" Classes="value"
                             Text="{Binding RecentSessions.Count}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ── Recent sessions table ── -->
        <Border Classes="panel">
          <StackPanel>
            <TextBlock Text="RECENT SESSIONS" Classes="panelTitle"/>

            <Grid ColumnDefinitions="*,110,110,150" Margin="0,0,0,2">
              <TextBlock Grid.Column="0" Text="Application" FontSize="11"
                         Foreground="{DynamicResource Text3}"/>
              <TextBlock Grid.Column="1" Text="Average FPS" FontSize="11"
                         Foreground="{DynamicResource Text3}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="1% low" FontSize="11"
                         Foreground="{DynamicResource Text3}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="When" FontSize="11"
                         Foreground="{DynamicResource Text3}" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="No sessions recorded yet." FontSize="12"
                       Foreground="{DynamicResource Text3}" Margin="0,10,0,2"
                       IsVisible="{Binding !RecentSessions.Count}"/>

            <ItemsControl ItemsSource="{Binding RecentSessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="row">
                    <Grid ColumnDefinitions="*,110,110,150">
                      <TextBlock Grid.Column="0" Text="{Binding GameName}" Classes="key"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding AvgFpsValue}" Classes="value"/>
                      <TextBlock Grid.Column="2" Text="{Binding OnePctLowValue}" Classes="value"
                                 Foreground="{DynamicResource Text2}"/>
                      <TextBlock Grid.Column="3" Text="{Binding StartedAtDisplay}" Classes="value"
                                 Foreground="{DynamicResource Text3}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
