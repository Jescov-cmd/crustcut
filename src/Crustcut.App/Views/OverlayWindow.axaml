<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Crustcut.App.Views.OverlayWindow"
        Title="Crustcut Overlay"
        SizeToContent="WidthAndHeight"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False">

  <Border x:Name="Root" CornerRadius="8" Padding="11,8" Background="#00000000">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding FpsText}" IsVisible="{Binding ShowFps}"
                 FontFamily="Consolas, monospace" FontWeight="Bold"
                 FontSize="{Binding FontSize}" Foreground="#3ECF8E"/>
      <TextBlock Text="{Binding CpuText}" IsVisible="{Binding ShowCpu}"
                 FontFamily="Consolas, monospace"
                 FontSize="{Binding FontSize}" Foreground="#F2E4CC"/>
      <TextBlock Text="{Binding GpuText}" IsVisible="{Binding ShowGpu}"
                 FontFamily="Consolas, monospace"
                 FontSize="{Binding FontSize}" Foreground="#F2E4CC"/>
      <TextBlock Text="{Binding RamText}" IsVisible="{Binding ShowRam}"
                 FontFamily="Consolas, monospace"
                 FontSize="{Binding FontSize}" Foreground="#F2E4CC"/>
      <TextBlock Text="{Binding VramText}" FontFamily="Consolas, monospace"
                 FontSize="{Binding FontSize}" Foreground="#F2E4CC">
        <TextBlock.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowVram"/>
            <Binding Path="HasVram"/>
          </MultiBinding>
        </TextBlock.IsVisible>
      </TextBlock>
      <TextBlock Text="{Binding NetText}" IsVisible="{Binding ShowNet}"
                 FontFamily="Consolas, monospace"
                 FontSize="{Binding FontSize}" Foreground="#F2E4CC"/>
    </StackPanel>
  </Border>
</Window>
