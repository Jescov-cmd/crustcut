<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:Crustcut.App.Controls"
             x:Class="Crustcut.App.Views.SettingsView">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="MaxWidth" Value="1000"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <cc:FitWidth Padding="40,0,40,24">
    <!-- Grid + bound width, as on What's new: a StackPanel measured inside a ScrollViewer
         can take its text's natural width and run past the right edge. -->
    <Grid x:Name="PanelGrid" MaxWidth="1000">
    <StackPanel>
      <TextBlock Text="Settings" Classes="hero" Margin="0,40,0,20"/>

      <!-- ── Memory cleanup ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="Memory cleanup" Classes="label"/>

          <StackPanel>
            <CheckBox IsChecked="{Binding RamAdaptiveEnabled, Mode=TwoWay}"
                      Content="Adaptive cleanup (recommended)"
                      Foreground="{DynamicResource Text1}"/>
            <TextBlock Classes="hint"
                       Text="Crustcut watches memory pressure every minute and decides when to clean: nothing while memory is comfortable, more often as pressure rises, and it backs off entirely mid paging-storm. It only ever trims idle background programs — Windows' file cache is never purged automatically, because that just makes things reload from disk. The manual schedule below is ignored while this is on."/>
          </StackPanel>

          <StackPanel IsEnabled="{Binding !RamAdaptiveEnabled}">
          <StackPanel Spacing="12">
          <CheckBox IsChecked="{Binding RamAutoOptimizeOnInterval, Mode=TwoWay}"
                    Content="Clean up memory on a schedule"
                    Foreground="{DynamicResource Text1}"/>

          <StackPanel IsEnabled="{Binding RamAutoOptimizeOnInterval}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Every" Foreground="{DynamicResource Text2}"
                         FontSize="12" VerticalAlignment="Center"/>
              <NumericUpDown Value="{Binding RamAutoIntervalMinutes, Mode=TwoWay}"
                             Minimum="5" Maximum="120" Increment="1" Width="110"
                             FormatString="0"/>
              <TextBlock Text="minutes" Foreground="{DynamicResource Text2}"
                         FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Classes="hint"
                       Text="Scheduled cleanup only runs when memory is actually above 70% — evicting memory that apps still need just makes Windows compress it and burn CPU putting it back."/>
            <Border Background="#22FFB84D" CornerRadius="2" Padding="11,8" Margin="0,10,0,0"
                    IsVisible="{Binding IntervalIsAggressive}">
              <TextBlock FontSize="11" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                         Text="Short intervals re-evict memory before it settles. 10 minutes or more is plenty."/>
            </Border>
          </StackPanel>

          <CheckBox IsChecked="{Binding RamAutoOptimizeOnThreshold, Mode=TwoWay}"
                    Content="Also clean up when memory gets full"
                    Foreground="{DynamicResource Text1}"/>

          <StackPanel Orientation="Horizontal" Spacing="10"
                      IsEnabled="{Binding RamAutoOptimizeOnThreshold}">
            <TextBlock Text="Above" Foreground="{DynamicResource Text2}"
                       FontSize="12" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding RamThresholdPercent, Mode=TwoWay}"
                           Minimum="50" Maximum="99" Increment="1" Width="110"
                           FormatString="0"/>
            <TextBlock Text="% used" Foreground="{DynamicResource Text2}"
                       FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Startup ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="Startup" Classes="label"/>

          <StackPanel>
            <CheckBox IsChecked="{Binding StartAtBoot, Mode=TwoWay}"
                      Content="Start Crustcut when Windows starts"
                      Foreground="{DynamicResource Text1}"/>
          </StackPanel>

          <StackPanel>
            <CheckBox IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                      Content="Start minimised to the system tray"
                      Foreground="{DynamicResource Text1}"/>
            <TextBlock Classes="hint"
                       Text="With this on, opening Crustcut shows no window — click the tray icon to bring it up."/>
          </StackPanel>

          <CheckBox IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                    Content="Keep running in the tray when the window is closed"
                    Foreground="{DynamicResource Text1}"/>
        </StackPanel>
      </Border>

      <!-- ── Performance overlay ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="In-game overlay" Classes="label"/>
          <CheckBox IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"
                    Content="Show the performance overlay"
                    Foreground="{DynamicResource Text1}"/>
          <CheckBox IsChecked="{Binding OverlayOnlyInGame, Mode=TwoWay}"
                    Content="Only while a game is running"
                    Foreground="{DynamicResource Text1}"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <CheckBox IsChecked="{Binding OverlayShowFps, Mode=TwoWay}" Content="FPS"
                      Foreground="{DynamicResource Text1}"/>
            <CheckBox IsChecked="{Binding OverlayShowCpu, Mode=TwoWay}" Content="CPU"
                      Foreground="{DynamicResource Text1}"/>
            <CheckBox IsChecked="{Binding OverlayShowGpu, Mode=TwoWay}" Content="GPU"
                      Foreground="{DynamicResource Text1}"/>
            <CheckBox IsChecked="{Binding OverlayShowRam, Mode=TwoWay}" Content="RAM"
                      Foreground="{DynamicResource Text1}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Reposition" Classes="secondary" Click="RepositionClick"/>
            <TextBlock Text="or press Ctrl+Shift+O in game" Classes="hint" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Monitoring ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="Monitoring" Classes="label"/>
          <StackPanel>
            <CheckBox IsChecked="{Binding SentinelEnabled, Mode=TwoWay}"
                      Content="Watch performance while apps run"
                      Foreground="{DynamicResource Text1}"/>
            <TextBlock Classes="hint"
                       Text="Records frame times and flags problems it spots during a session."/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── About: the one card that exists on every platform, so Settings is never
           an empty page (on macOS all four cards above are hidden). ── -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="About" Classes="label"/>
          <TextBlock Text="{Binding AboutText}" FontSize="12"
                     Foreground="{DynamicResource Text1}"/>
          <TextBlock Classes="hint" IsVisible="{Binding !IsWindows}"
                     Text="Early preview on this platform — optimization features are Windows-only for now."/>
        </StackPanel>
      </Border>

      <!-- History, Guides and What's new used to be rail pages; they live here now. -->
      <TextBlock Classes="statLabel" Text="More" Margin="0,12,0,4"/>
      <Button Classes="rowLink" Click="GoClick" Tag="History" x:Name="HistoryLink">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="key" Text="History"/>
            <TextBlock Classes="sub" Text="Every change Crustcut made, with undo."/>
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="chevron"/>
        </Grid>
      </Button>
      <Button Classes="rowLink" Click="GoClick" Tag="Guides" x:Name="GuidesLink">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="key" Text="Guides"/>
            <TextBlock Classes="sub" Text="BIOS, graphics driver and memory speed, step by step."/>
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="chevron"/>
        </Grid>
      </Button>
      <Button Classes="rowLink" Click="GoClick" Tag="WhatsNew" BorderThickness="0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="key" Text="What's new"/>
            <TextBlock Classes="sub" Text="What changed in each version."/>
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="chevron"/>
        </Grid>
      </Button>

      <TextBlock Text="{Binding Status}" Classes="hint" Margin="2,16,0,24"/>
    </StackPanel>
    </Grid>
    </cc:FitWidth>
  </ScrollViewer>
</UserControl>
