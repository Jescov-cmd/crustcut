<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.Views.SettingsView">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Width" Value="620"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
    <StackPanel>
      <TextBlock Text="Settings" Classes="pageTitle" Margin="0,16,0,12"/>

      <!-- ── Memory cleanup ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="MEMORY CLEANUP" Classes="label"/>

          <CheckBox IsChecked="{Binding RamAutoOptimizeOnInterval, Mode=TwoWay}"
                    Content="Clean up memory on a schedule"
                    Foreground="{DynamicResource Text1}"/>

          <StackPanel IsEnabled="{Binding RamAutoOptimizeOnInterval}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Every" Foreground="{DynamicResource Text2}"
                         FontSize="12" VerticalAlignment="Center"/>
              <NumericUpDown Value="{Binding RamAutoIntervalMinutes, Mode=TwoWay}"
                             Minimum="5" Maximum="120" Increment="1" Width="110"
                             FormatString="0"/>
              <TextBlock Text="minutes" Foreground="{DynamicResource Text2}"
                         FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Classes="hint"
                       Text="Scheduled cleanup only runs when memory is actually above 70% — evicting memory that apps still need just makes Windows compress it and burn CPU putting it back."/>
            <Border Background="#22FFB84D" CornerRadius="8" Padding="11,8" Margin="0,10,0,0"
                    IsVisible="{Binding IntervalIsAggressive}">
              <TextBlock FontSize="11" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                         Text="Short intervals re-evict memory before it settles. 10 minutes or more is plenty."/>
            </Border>
          </StackPanel>

          <CheckBox IsChecked="{Binding RamAutoOptimizeOnThreshold, Mode=TwoWay}"
                    Content="Also clean up when memory gets full"
                    Foreground="{DynamicResource Text1}"/>

          <StackPanel Orientation="Horizontal" Spacing="10"
                      IsEnabled="{Binding RamAutoOptimizeOnThreshold}">
            <TextBlock Text="Above" Foreground="{DynamicResource Text2}"
                       FontSize="12" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding RamThresholdPercent, Mode=TwoWay}"
                           Minimum="50" Maximum="99" Increment="1" Width="110"
                           FormatString="0"/>
            <TextBlock Text="% used" Foreground="{DynamicResource Text2}"
                       FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel>
            <CheckBox IsChecked="{Binding StandbyAutoPurgeEnabled, Mode=TwoWay}"
                      Content="Clear standby cache when memory gets critically tight"
                      Foreground="{DynamicResource Text1}"/>
            <TextBlock Classes="hint"
                       Text="The game-stutter fix (what ISLC does): fires only when free memory drops under 1 GB while Windows' file cache holds over 1.5 GB — never on a healthy system, at most every 10 minutes."/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Startup ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="STARTUP" Classes="label"/>

          <StackPanel>
            <CheckBox IsChecked="{Binding StartAtBoot, Mode=TwoWay}"
                      Content="Start Crustcut when Windows starts"
                      Foreground="{DynamicResource Text1}"/>
          </StackPanel>

          <StackPanel>
            <CheckBox IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                      Content="Start minimised to the system tray"
                      Foreground="{DynamicResource Text1}"/>
            <TextBlock Classes="hint"
                       Text="With this on, opening Crustcut shows no window — click the tray icon to bring it up."/>
          </StackPanel>

          <CheckBox IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                    Content="Keep running in the tray when the window is closed"
                    Foreground="{DynamicResource Text1}"/>
        </StackPanel>
      </Border>

      <!-- ── Performance overlay ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="IN-GAME OVERLAY" Classes="label"/>
          <CheckBox IsChecked="{Binding OverlayEnabled, Mode=TwoWay}"
                    Content="Show the performance overlay"
                    Foreground="{DynamicResource Text1}"/>
          <CheckBox IsChecked="{Binding OverlayOnlyInGame, Mode=TwoWay}"
                    Content="Only while a game is running"
                    Foreground="{DynamicResource Text1}"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <CheckBox IsChecked="{Binding OverlayShowFps, Mode=TwoWay}" Content="FPS"
                      Foreground="{DynamicResource Text1}"/>
            <CheckBox IsChecked="{Binding OverlayShowCpu, Mode=TwoWay}" Content="CPU"
                      Foreground="{DynamicResource Text1}"/>
            <CheckBox IsChecked="{Binding OverlayShowGpu, Mode=TwoWay}" Content="GPU"
                      Foreground="{DynamicResource Text1}"/>
            <CheckBox IsChecked="{Binding OverlayShowRam, Mode=TwoWay}" Content="RAM"
                      Foreground="{DynamicResource Text1}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="REPOSITION" Classes="secondary" Click="RepositionClick"/>
            <TextBlock Text="or press Ctrl+Shift+O in game" Classes="hint" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Monitoring ── -->
      <Border Classes="card" IsVisible="{Binding IsWindows}">
        <StackPanel Spacing="12">
          <TextBlock Text="MONITORING" Classes="label"/>
          <StackPanel>
            <CheckBox IsChecked="{Binding SentinelEnabled, Mode=TwoWay}"
                      Content="Watch performance while apps run"
                      Foreground="{DynamicResource Text1}"/>
            <TextBlock Classes="hint"
                       Text="Records frame times and flags problems it spots during a session."/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── About: the one card that exists on every platform, so Settings is never
           an empty page (on macOS all four cards above are hidden). ── -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="ABOUT" Classes="label"/>
          <TextBlock Text="{Binding AboutText}" FontSize="12"
                     Foreground="{DynamicResource Text1}"/>
          <TextBlock Classes="hint" IsVisible="{Binding !IsWindows}"
                     Text="Early preview on this platform — optimization features are Windows-only for now."/>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}" Classes="hint" Margin="2,0,0,24"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
