<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Crustcut.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Crustcut/Theme/Tokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Crustcut/Theme/Controls.axaml"/>
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://Crustcut/Assets/icon.ico"
                ToolTipText="Crustcut"
                Clicked="TrayClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Crustcut" Click="TrayOpenClick"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Exit" Click="TrayExitClick"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
