<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Utility-tool palette: neutral greys, flat panels, hairline rules. Modelled on the
       classic control-panel look (dense, functional, no decoration) but with modern
       typography and spacing instead of period chrome. The warm accent is used only for
       selection, values and the primary action — never as a background wash. -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="SurfaceBase"  Color="#161616"/>  <!-- content background -->
  <SolidColorBrush x:Key="SurfaceRail"  Color="#1B1B1B"/>  <!-- nav rail -->
  <SolidColorBrush x:Key="SurfacePanel" Color="#1E1E1E"/>  <!-- grouped panels -->
  <SolidColorBrush x:Key="SurfaceCard"  Color="#1E1E1E"/>  <!-- alias, same value -->
  <SolidColorBrush x:Key="SurfaceRow"   Color="#00000000"/><!-- rows are bare by default -->
  <SolidColorBrush x:Key="SurfaceHover" Color="#262626"/>
  <SolidColorBrush x:Key="SurfaceSelected" Color="#2C2C2C"/>

  <!-- Rules: a real 1px line, not a translucent wash — this is what makes dense
       information legible without boxing everything in. -->
  <SolidColorBrush x:Key="Hairline"     Color="#2E2E2E"/>
  <SolidColorBrush x:Key="HairlineSoft" Color="#242424"/>

  <!-- Text -->
  <SolidColorBrush x:Key="Text0" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Text1" Color="#DCDCDC"/>
  <SolidColorBrush x:Key="Text2" Color="#9B9B9B"/>
  <SolidColorBrush x:Key="Text3" Color="#6E6E6E"/>

  <!-- Accent: kept, but used sparingly -->
  <SolidColorBrush x:Key="AccentWheat" Color="#E0A860"/>
  <SolidColorBrush x:Key="AccentCrust" Color="#B4763A"/>
  <SolidColorBrush x:Key="AccentGradient" Color="#E0A860"/>   <!-- flat now, name kept -->
  <SolidColorBrush x:Key="AmbientGlow" Color="Transparent"/>  <!-- no glow in this style -->

  <!-- Status -->
  <SolidColorBrush x:Key="Good"   Color="#5FBF7F"/>
  <SolidColorBrush x:Key="Warn"   Color="#D9A441"/>
  <SolidColorBrush x:Key="Danger" Color="#D96565"/>
</ResourceDictionary>
