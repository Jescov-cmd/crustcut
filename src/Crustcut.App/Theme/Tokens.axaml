<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- OLED black and white. True black everywhere (pixels off on OLED), structure from
       hairlines rather than lighter layers, and white as the only accent: selection, the
       one primary button per page, switches. Colour is reserved for status (good / warn /
       danger). Key names predate this palette and are kept so every view keeps resolving —
       AccentWheat is now white, whatever its name says. -->

  <!-- Fluent reads these for switches, checkboxes, sliders, focus rings and combo boxes.
       Pinned instead of following the Windows accent: his is red, which reads as "error". -->
  <Color x:Key="SystemAccentColor">#FFFFFF</Color>
  <Color x:Key="SystemAccentColorDark1">#E6E6E6</Color>
  <Color x:Key="SystemAccentColorDark2">#CCCCCC</Color>
  <Color x:Key="SystemAccentColorDark3">#999999</Color>
  <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
  <Color x:Key="SystemAccentColorLight2">#FFFFFF</Color>
  <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>

  <!-- Fluent draws the switch knob in "text on accent", which is white here too — on a
       white track that's an invisible knob. Black knob when on. -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000"/>
  <!-- Locked-on switches (device software at startup) read as "on, can't change". -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#000000"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#707070"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#707070"/>

  <!-- Same problem for checkbox ticks: white box, white tick. -->
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="#000000"/>

  <!-- Selected list rows and dropdown items: Fluent fills them with the accent, which is
       white here — white text on white. A grey fill with white text instead. -->
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#262626"/>
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#333333"/>
  <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPressed" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#262626"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#333333"/>
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FFFFFF"/>

  <!-- Surfaces -->
  <SolidColorBrush x:Key="SurfaceRail"  Color="#000000"/>  <!-- window + nav -->
  <SolidColorBrush x:Key="SurfaceBase"  Color="#000000"/>  <!-- content layer -->
  <SolidColorBrush x:Key="SurfacePanel" Color="#0A0A0A"/>  <!-- cards -->
  <SolidColorBrush x:Key="SurfaceCard"  Color="#0A0A0A"/>
  <SolidColorBrush x:Key="SurfaceRow"   Color="#00000000"/>
  <SolidColorBrush x:Key="SurfaceHover" Color="#141414"/>
  <SolidColorBrush x:Key="SurfaceSelected" Color="#141414"/>
  <SolidColorBrush x:Key="SurfaceControl" Color="#141414"/> <!-- buttons, inputs -->
  <SolidColorBrush x:Key="SurfaceControlHover" Color="#1F1F1F"/>

  <!-- On black there is no darker edge to draw depth with, so cards are outlined by a
       faint hairline instead. -->
  <SolidColorBrush x:Key="Hairline"     Color="#222222"/>
  <SolidColorBrush x:Key="HairlineSoft" Color="#1A1A1A"/>  <!-- dividers inside a card -->
  <SolidColorBrush x:Key="ControlStroke" Color="#333333"/>

  <!-- Text: white and three steps of grey -->
  <SolidColorBrush x:Key="Text0" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Text1" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Text2" Color="#A3A3A3"/>
  <SolidColorBrush x:Key="Text3" Color="#707070"/>

  <!-- Accent -->
  <SolidColorBrush x:Key="AccentWheat" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentCrust" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentGradient" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentText" Color="#000000"/>    <!-- text on the accent -->
  <SolidColorBrush x:Key="AmbientGlow" Color="Transparent"/>

  <!-- Status: Windows' own success / caution / critical -->
  <SolidColorBrush x:Key="Good"   Color="#6CCB5F"/>
  <SolidColorBrush x:Key="Warn"   Color="#FCE100"/>
  <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
