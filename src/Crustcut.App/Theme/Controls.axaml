<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared Windows 11 styling. Every page uses these classes so the look is defined
       once; per-view style blocks are how the pages drifted apart in the first place.
       Conventions copied from the inbox apps: sentence-case labels, 4 px control corners,
       8 px card corners, 32 px buttons, cards on a slightly lighter layer. -->

  <!-- ── Page header: title, subtitle, right-aligned actions ── -->
  <Style Selector="Border.pageHeader">
    <Setter Property="Padding" Value="28,22,28,10"/>
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- Section heading above a group of cards ("Live", "Recent sessions"). -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="Margin" Value="0,10,0,8"/>
  </Style>

  <!-- ── Cards and rows ── -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfacePanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,12,16,14"/>
  </Style>
  <!-- One setting per card, Windows Settings style: icon, title + description, control. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfacePanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="16,13"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="MinHeight" Value="64"/>
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="TextBlock.cardIcon">
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0,10"/>
  </Style>
  <Style Selector="Border.row.last">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ── Text roles ── -->
  <Style Selector="TextBlock.key">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <!-- Without wrap, the longest title dictates a MINIMUM row width and rows overflow
         their card at narrow window sizes. -->
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.colHead">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
  </Style>
  <!-- Tabular figures keep ticking numbers from jittering sideways, without a
       typewriter font. -->
  <Style Selector="TextBlock.value">
    <Setter Property="FontFeatures" Value="+tnum"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontFeatures" Value="+tnum"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
  </Style>

  <!-- ── Buttons ──
       Base style targets EVERY Button, so a button that forgets a class still matches. -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceControl}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceControlHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text0}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#0F0F0F"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text2}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#0A0A0A"/>
    <Setter Property="TextElement.Foreground" Value="#4A4A4A"/>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentWheat}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentCrust}"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E6E6E6"/>
    <Setter Property="BorderBrush" Value="#E6E6E6"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#CCCCCC"/>
    <Setter Property="TextElement.Foreground" Value="#333333"/>
  </Style>
  <Style Selector="Button.secondary"/>
  <!-- Borderless, for "more" menus and icon-only actions inside cards. -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1A1A1A"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}"/>
  </Style>

  <!-- ── Protect toggle (Memory rows) ── -->
  <Style Selector="ToggleButton.protect">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceControl}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.protect:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWheat}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentCrust}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentText}"/>
  </Style>

  <!-- A row of these (Memory's Protect) as solid accent became a wall of white. "soft"
       marks the on state with a grey fill and outline instead. -->
  <Style Selector="ToggleButton.protect.soft:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#1A1A1A"/>
    <Setter Property="BorderBrush" Value="#808080"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentWheat}"/>
  </Style>

  <!-- ── Toggle switch: Fluent's own Windows 11 switch, recoloured through
       SystemAccentColor. Only the empty On/Off label reservation is stripped, which
       otherwise made the switch ~12 px wider than it looks and overflow its column. ── -->
  <Style Selector="ToggleSwitch">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ToggleSwitch /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <!-- ── Inputs ── -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
  </Style>

  <!-- Thin, Windows-style scrollbars. -->
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="12"/>
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MaxWidth" Value="360"/>
  </Style>

  <!-- ── Simple pages (Home, Boost, Games, Settings) ── -->
  <Style Selector="TextBlock.hero">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontSize" Value="32"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.statLabel">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontFeatures" Value="+tnum"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
  </Style>
  <Style Selector="Button.big">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- A whole row you click: title + detail on the left, a chevron on the right. -->
  <Style Selector="Button.rowLink">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="4,14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.rowLink:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0D0D0D"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}"/>
  </Style>
  <Style Selector="Button.rowLink:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#141414"/>
  </Style>
  <Style Selector="TextBlock.chevron">
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Text" Value="&#xE76C;"/>
  </Style>
  <!-- A switch row: title + description, switch on the right. -->
  <Style Selector="Border.switchRow">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="4,16"/>
  </Style>
  <!-- Selected rows in lists and dropdowns: grey fill, white text (the accent is white). -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#262626"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2E2E2E"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#333333"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
</Styles>
