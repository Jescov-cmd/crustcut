<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared control-panel styling. Every page uses these classes so the look is defined
       once; per-view style blocks are how the pages drifted apart in the first place. -->

  <!-- ── Page header: title, subtitle, right-aligned actions ── -->
  <Style Selector="Border.pageHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="20,14"/>
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ── Panels and rows ── -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfacePanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="14,10,14,12"/>
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0,9"/>
  </Style>
  <Style Selector="Border.row.last">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ── Text roles ── -->
  <Style Selector="TextBlock.key">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.colHead">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
  </Style>
  <!-- Monospace so values stay column-aligned while they tick. -->
  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>

  <!-- ── Buttons ──
       Base style targets EVERY Button, not an opt-in class. Class-based styling meant any
       button that forgot the class fell through to Fluent's defaults, which is why buttons
       looked inconsistent and their labels sat off-centre across the app. -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <!-- Fluent's template drives the visual state from the ContentPresenter, so hover and
       pressed have to be repainted there or they revert to its own accent. -->
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text0}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentWheat}"/>
    <Setter Property="Foreground" Value="#1A1206"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F0BC74"/>
    <Setter Property="TextElement.Foreground" Value="#1A1206"/>
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="#4D3030"/>
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A1818"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Danger}"/>
  </Style>

  <!-- ── Toggle: Fluent's default is a bright red/blue accent that clashes with the
       palette. Repainted to the wheat accent. ── -->
  <Style Selector="ToggleSwitch">
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentWheat}"/>
  </Style>
  <Style Selector="ToggleSwitch:unchecked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="#3A3A3A"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="#1A1206"/>
  </Style>

  <!-- ── Inputs ── -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#141414"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
  </Style>
  <!-- Fluent paints the checked box with its own accent (bright red here). Repaint it. -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource AccentWheat}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentWheat}"/>
  </Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="#1A1206"/>
    <Setter Property="Stroke" Value="#1A1206"/>
  </Style>
  <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="#4A4A4A"/>
  </Style>
</Styles>
