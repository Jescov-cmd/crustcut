<?xml version="1.0" encoding="utf-8"?>
<!--
  The shipping Windows build:
    dotnet publish src/Crustcut.App/Crustcut.App.csproj -f net10.0-windows -p:PublishProfile=win-x64 -o publish/<version>
  (-f is required: the project also targets macOS, and the framework has to be chosen
  before a publish profile is read.)

  Single self-contained exe (nothing for the user to install), deliberately NOT compressed.
  A compressed single-file bundle can't map its assemblies from the file: at startup every
  one is unpacked into private memory, where it stays. Measured on the same code (tray idle):
    compressed    44 MB exe  ~100 MB private
    uncompressed  90 MB exe   ~63 MB private
  ReadyToRun was measured too: +6 MB private and a 142 MB exe for faster first page opens.
  For a tray app whose whole complaint was memory, the smallest footprint wins.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
