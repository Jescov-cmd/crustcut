<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Crustcut.App.TrayPopup"
        Title="Crustcut"
        Width="280"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF">

  <!-- Every colour lives here, not in the app theme: the popup is a black OLED surface
       whatever the main window's theme does. Local resources win over the theme's. -->
  <Window.Resources>
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#141414"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="#8A8A8A"/>
    </Style>

    <!-- Rows: own template, so no theme pointer-over brush can bleed in. -->
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="RowContent"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.row:pointerover">
      <Setter Property="Background" Value="#141414"/>
    </Style>
    <Style Selector="Button.row:pressed">
      <Setter Property="Background" Value="#1C1C1C"/>
    </Style>
    <Style Selector="Button.row:disabled">
      <Setter Property="Foreground" Value="#8A8A8A"/>
    </Style>

    <!-- Plain text buttons for the footer. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="LinkContent" Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Background" Value="#141414"/>
    </Style>
    <Style Selector="Button.link.secondary">
      <Setter Property="Foreground" Value="#8A8A8A"/>
    </Style>
    <Style Selector="Button.link.secondary:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Switch: white track, black knob when on; outline when off. Stated as styles too,
         in case the app theme restyles the template parts directly. -->
    <Style Selector="ToggleSwitch">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ToggleSwitch /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="#000000"/>
    </Style>
    <Style Selector="ToggleSwitch:unchecked /template/ Border#OuterBorder">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#8A8A8A"/>
    </Style>
    <Style Selector="ToggleSwitch:unchecked /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="#8A8A8A"/>
    </Style>
  </Window.Styles>

  <Border Background="#000000" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10"
          ClipToBounds="True">
    <StackPanel>
      <!-- Header: name, then the live line. -->
      <StackPanel Margin="14,12,14,10" Spacing="4">
        <TextBlock Text="Crustcut" FontSize="12" Classes="secondary"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="LiveText" Text="—" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="FansText" Grid.Column="1" Text="Fans: off" FontSize="12"
                     Classes="secondary" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>

      <Border Height="1" Background="#1C1C1C"/>

      <!-- Game mode: the whole row toggles, the switch shows the state. -->
      <Button x:Name="GameModeRow" Classes="row" Click="GameModeRowClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Game mode" VerticalAlignment="Center"/>
          <ToggleSwitch x:Name="GameModeSwitch" Grid.Column="1"
                        OnContent="{x:Null}" OffContent="{x:Null}"
                        VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Button>

      <Border Height="1" Background="#1C1C1C"/>

      <Button x:Name="FreeMemoryRow" Classes="row" Click="FreeMemoryClick">
        <TextBlock Text="Free up memory" VerticalAlignment="Center"/>
      </Button>
      <TextBlock x:Name="ResultText" IsVisible="False" FontSize="12" Classes="secondary"
                 TextWrapping="Wrap" Margin="14,0,14,8"/>

      <Border Height="1" Background="#1C1C1C"/>

      <Grid ColumnDefinitions="*,Auto" Margin="6,6,6,6">
        <Button Classes="link" Content="Open Crustcut" Click="OpenClick"
                HorizontalAlignment="Left"/>
        <Button Grid.Column="1" Classes="link secondary" Content="Quit" Click="QuitClick"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
