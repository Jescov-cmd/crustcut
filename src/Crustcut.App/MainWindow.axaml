<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Crustcut.App.MainWindow"
        Title="Crustcut"
        Width="1240" Height="780" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBase}"
        Icon="avares://Crustcut/Assets/icon.ico"
        FontFamily="Segoe UI"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <!-- Nav row: square, full-bleed, hairline-free. Selection is a filled row plus a 3px
         accent bar on the left edge — the classic control-panel affordance. -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="26,0,12,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
    </Style>

    <Style Selector="TextBlock.groupLabel">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="Margin" Value="12,16,0,5"/>
    </Style>

    <!-- Window controls: square, borderless, generous hit area — ours, not Windows'. -->
    <Style Selector="Button.winctl">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.winctl:pressed">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.winctl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E2E2E"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text0}"/>
    </Style>
    <!-- Close hovers red — the one convention worth keeping from stock chrome. -->
    <Style Selector="Button.winctl.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C"/>
      <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
    </Style>
  </Window.Styles>

  <!-- Custom chrome: the native title bar is gone (ExtendClientArea + NoChrome), so the
       top strip is ours — wordmark on the left, square minimize/close on the right, the
       whole strip draggable. This is what removes the stock icon-and-title row. -->
  <Grid RowDefinitions="34,*">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceRail}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Brand: the 8-bit wordmark. Rendered at 2x and displayed at half size so the
             pixels stay crisp on high-DPI displays. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" Margin="14,0,0,0">
          <Image Source="avares://Crustcut/Assets/wordmark.png" Height="16"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <!-- Set from the real assembly version in code-behind; a hardcoded string
               here silently drifted a version behind at least once. -->
          <TextBlock x:Name="VersionLabel" FontSize="9.5"
                     Foreground="{DynamicResource Text3}"
                     VerticalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="winctl" Content="─" Click="MinimizeClick"/>
        <Button Grid.Column="3" Classes="winctl close" Content="✕" Click="CloseClick"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="216,1,*">

      <!-- ===== NAV TREE ===== -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceRail}">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Height="30" Padding="12,0"
                  BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Good}"/>
              <TextBlock Text="Watching apps" FontSize="11"
                         Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Bottom}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Border Width="3" HorizontalAlignment="Left"
                          Background="{DynamicResource AccentWheat}"
                          IsVisible="{Binding IsActive}"/>
                  <Button Classes="nav" Classes.active="{Binding IsActive}"
                          Content="{Binding Label}"
                          Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                          CommandParameter="{Binding Id}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding Primary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Classes="groupLabel" Text="{Binding Group}"
                               IsVisible="{Binding ShowGroupHeader}"/>
                    <Grid>
                      <Border Width="3" HorizontalAlignment="Left"
                              Background="{DynamicResource AccentWheat}"
                              IsVisible="{Binding IsActive}"/>
                      <Button Classes="nav" Classes.active="{Binding IsActive}"
                              Content="{Binding Label}"
                              Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                              CommandParameter="{Binding Id}"/>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource Hairline}"/>

      <!-- ===== CONTENT ===== -->
      <DockPanel Grid.Column="2">
        <!-- Update banner: only present when there is genuinely a newer release. -->
        <Border DockPanel.Dock="Top" x:Name="UpdateBanner"
                Background="#1E1E1E" BorderBrush="{DynamicResource AccentWheat}"
                BorderThickness="0,0,0,1" Padding="20,10" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Column="0" Width="3" Background="{DynamicResource AccentWheat}"
                    Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="UpdateHeadline" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text0}"/>
              <TextBlock x:Name="UpdateStatus" FontSize="11"
                         Foreground="{DynamicResource Text3}"
                         IsVisible="False"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="UpdateLaterButton" Content="LATER"
                    Classes="secondary" Margin="0,0,8,0" Click="UpdateLaterClick"/>
            <Button Grid.Column="3" x:Name="UpdateNowButton" Content="UPDATE"
                    Classes="primary" Click="UpdateNowClick"/>
          </Grid>
        </Border>

        <ContentControl x:Name="PageHost"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
