<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="Crustcut.App.MainWindow"
        Title="Crustcut"
        Width="1240" Height="780" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceRail}"
        Icon="avares://Crustcut/Assets/icon.ico"
        FontFamily="{DynamicResource UiFont}"
        SystemDecorations="None">

  <Window.Styles>
    <!-- Nav row: square, full-bleed, hairline-free. Selection is a filled row plus a 3px
         accent bar on the left edge — the classic control-panel affordance. -->
    <!-- Nav row, Windows 11 NavigationView: 36 px, rounded, icon + label, selection is a
         soft fill plus a short accent pill on the left edge. -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="6,1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#111111"/>
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0D0D0D"/>
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#161616"/>
    </Style>
    <Style Selector="Button.backBar">
      <Setter Property="Margin" Value="20,14,0,0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    </Style>
    <Style Selector="TextBlock.navIcon">
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="20"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.groupLabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="Margin" Value="18,14,0,4"/>
    </Style>

    <!-- SystemDecorations=None, not ExtendClientArea: two attempts at "extend and hide
         the chrome" left EITHER Avalonia's drawn title OR the native caption buttons
         painting over ours (and the self-render screenshots can't see native chrome, so
         each looked fixed until the user saw the real screen). Borderless is the only
         deterministic answer: nothing draws chrome but us. Resize is reimplemented via
         edge grips in code-behind; rounded corners come back via DWM in code. -->

    <!-- Window controls: square, borderless, generous hit area — ours, not Windows'. -->
    <Style Selector="Button.winctl">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="Button.winctl:pressed">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.winctl:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Text0}"/>
    </Style>
    <!-- Close hovers red — the one convention worth keeping from stock chrome. -->
    <Style Selector="Button.winctl.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C"/>
      <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
    </Style>
  </Window.Styles>

  <!-- Custom chrome: the window is borderless, so the top strip is ours — wordmark on
       the left, square minimize/close on the right, the whole strip draggable. The
       invisible edge borders named Resize* are the window's resize grips. -->
  <Panel>
  <Grid RowDefinitions="32,*">

    <Border Grid.Row="0" Background="{DynamicResource SurfaceRail}"
            PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Brand: the 8-bit wordmark. Rendered at 2x and displayed at half size so the
             pixels stay crisp on high-DPI displays. -->
        <!-- Windows 11 caption: small app icon and the name in 12 px, as every inbox app. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0">
          <Image Source="avares://Crustcut/Assets/icon.ico" Width="16" Height="16"
                 VerticalAlignment="Center"/>
          <TextBlock Text="Crustcut" FontSize="12" Foreground="{DynamicResource Text2}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="winctl" Content="&#xE921;" Click="MinimizeClick"/>
        <Button Grid.Column="3" Classes="winctl close" Content="&#xE8BB;" Click="CloseClick"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== NAV TREE ===== -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceRail}">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Height="32" Padding="18,0">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Good}"/>
                <TextBlock Text="Watching apps" FontSize="11"
                           Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
              </StackPanel>
              <!-- Set from the real assembly version in code-behind; a hardcoded string
                   here silently drifted a version behind at least once. -->
              <TextBlock Grid.Column="1" x:Name="VersionLabel" FontSize="10"
                         Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Bottom}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Button Classes="nav" Classes.active="{Binding IsActive}"
                          Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Classes="navIcon" Text="{Binding Icon}"/>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Border Width="3" Height="16" CornerRadius="2" Margin="6,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Background="{DynamicResource AccentWheat}"
                          IsVisible="{Binding IsActive}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding Primary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Classes="groupLabel" Text="{Binding Group}"
                               IsVisible="{Binding ShowGroupHeader}"/>
                    <Grid>
                      <Button Classes="nav" Classes.active="{Binding IsActive}"
                              Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                              CommandParameter="{Binding Id}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Classes="navIcon" Text="{Binding Icon}"/>
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Border Width="3" Height="16" CornerRadius="2" Margin="6,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Background="{DynamicResource AccentWheat}"
                              IsVisible="{Binding IsActive}"/>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- On black, the rail and the page are one surface split by a single hairline. -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBase}"
              BorderBrush="{DynamicResource HairlineSoft}" BorderThickness="1,0,0,0"/>

      <!-- ===== CONTENT ===== -->
      <!-- Pages stop growing at 1440 px and sit centred in what's left. Maximized on a 3440
           ultrawide they stretched to ~3,200 px (a label on the left, its switch a monitor
           away); capping the column instead left a dead slab of empty window on the right. -->
      <DockPanel Grid.Column="2" MaxWidth="1440" HorizontalAlignment="Stretch">
        <!-- Update banner: only present when there is genuinely a newer release. -->
        <Border DockPanel.Dock="Top" x:Name="UpdateBanner"
                Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource Hairline}"
                BorderThickness="0,0,0,1" Padding="20,10" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Column="0" Width="3" Background="{DynamicResource AccentWheat}"
                    Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="UpdateHeadline" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text0}"/>
              <TextBlock x:Name="UpdateStatus" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource Text3}"
                         IsVisible="False"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="UpdateLaterButton" Content="Later"
                    Classes="secondary" Margin="0,0,8,0" Click="UpdateLaterClick"/>
            <Button Grid.Column="3" x:Name="UpdateNowButton" Content="Update"
                    Classes="primary" Click="UpdateNowClick"/>
          </Grid>
        </Border>

        <!-- Visited pages stay attached here and are switched by visibility. Swapping them
             in and out of a ContentControl re-applied every style and re-evaluated every
             binding on each visit (traced: ~1 s on Memory). Hidden pages skip layout and
             render, so keeping them attached costs nothing per frame. -->
        <!-- Pages opened from inside a rail page (All settings, Memory, History…) get one
             way back, so the four-page rail never leaves anyone lost. -->
        <Button DockPanel.Dock="Top" Classes="subtle backBar"
                IsVisible="{Binding IsSubPage}" Command="{Binding BackCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontFamily="{DynamicResource IconFont}" FontSize="12" Text="&#xE72B;"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Panel x:Name="PageHost"/>
      </DockPanel>
    </Grid>
  </Grid>

  <!-- Resize grips: 5px invisible strips on every edge and 10px corners, on top of
       everything. Borderless windows have no native resize border, so these ARE it. -->
  <Border Name="ResizeN"  Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="ResizePressed"/>
  <Border Name="ResizeS"  Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="ResizePressed"/>
  <Border Name="ResizeW"  Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" PointerPressed="ResizePressed"/>
  <Border Name="ResizeE"  Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" PointerPressed="ResizePressed"/>
  <Border Name="ResizeNW" Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Top"    Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizePressed"/>
  <Border Name="ResizeNE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"    Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizePressed"/>
  <Border Name="ResizeSW" Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizePressed"/>
  <Border Name="ResizeSE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizePressed"/>
  </Panel>
</Window>
