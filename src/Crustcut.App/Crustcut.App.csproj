<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9.0-windows is the shipping Windows build (defines WINDOWS for #if).
         Plain net9.0 is the macOS/other build: same UI shell, Windows-only subsystems
         compiled out, mac capability layer wired in Composition's #else branch. -->
    <TargetFrameworks>net9.0-windows;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Reflection bindings for now; compiled bindings get switched on in Phase 2 once
         every view has an x:DataType. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Crustcut</AssemblyName>
    <Version>0.9.2</Version>
    <RootNamespace>Crustcut.App</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <!-- PresentMon must sit next to the exe as a real file (it gets spawned as a
         subprocess), so it is copied to output rather than embedded. -->
    <None Include="Assets\PresentMon\PresentMon-x64.exe"
          Link="Assets\PresentMon\PresentMon-x64.exe"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crustcut.Presentation\Crustcut.Presentation.csproj" />
    <ProjectReference Include="..\PrimeOSTuner.Core\PrimeOSTuner.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <ProjectReference Include="..\PrimeOSTuner.Core.Windows\PrimeOSTuner.Core.Windows.csproj" />
    <ProjectReference Include="..\PrimeOSTuner.Win\PrimeOSTuner.Win.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <ProjectReference Include="..\PrimeOSTuner.Mac\PrimeOSTuner.Mac.csproj" />
  </ItemGroup>
</Project>
