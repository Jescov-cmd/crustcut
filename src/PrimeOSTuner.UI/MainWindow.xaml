<Window x:Class="PrimeOSTuner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crustcut"
        Height="780" Width="1240"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Windows 11 NavigationView-style rail item: left-aligned icon + label, subtle
             hover fill, and a vertical accent pill on the left when selected. -->
        <Style x:Key="NavRail" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Text0Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavRailActive" TargetType="Button" BasedOn="{StaticResource NavRail}">
            <Setter Property="Foreground" Value="{StaticResource Text0Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" Background="#18FFFFFF"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window caption button (minimize / maximize / close) -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Crust base: a near-black gradient lit by a warm tan/bread glow. The dark frosted nav
         rail / cards float on top with their own glass + glossy highlights. -->
    <Grid Background="{StaticResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT NAVIGATION RAIL (full height) ===================== -->
        <Border Grid.Column="0"
                Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand — sits in the draggable caption zone -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/Brand/bread.png"
                           Width="24" Height="24" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Crustcut"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="VersionText" Text="v0.7.0"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10" Foreground="{StaticResource Text3Brush}"
                               Margin="6,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Game-watcher status card — pinned to the bottom of the rail -->
                <Border DockPanel.Dock="Bottom" Margin="10,8,10,12" Padding="12,10"
                        CornerRadius="8" Background="#14FFFFFF"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- This Grid is WatcherStatusText.Parent; code-behind binds it to the watcher VM. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Text4Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock x:Name="WatcherStatusText" Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   FontSize="12" Foreground="{StaticResource Text2Brush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="WatcherToggle" Grid.Column="2"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding IsWatching, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Nav items (vertical list) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,10,0,0"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel>
                        <Button x:Name="NavDashboard" Tag="Dashboard" Click="NavButton_Click" Style="{StaticResource NavRailActive}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconDashboard}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavOptimize" Tag="Optimize" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconOptimize}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Optimize" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavGameBoost" Tag="GameBoost" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconGameBoost}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Game Boost" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavGameLibrary" Tag="GameLibrary" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconGameLibrary}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Library" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBloatware" Tag="Bloatware" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconBloatware}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Bloatware" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMemoryPriority" Tag="MemoryPriority" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconMemoryPriority}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Memory Priority" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavOptimization101" Tag="Optimization101" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconEducation}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Guides" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavHistory" Tag="History" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconHistory}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="History" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSentinel" Tag="Sentinel" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource IconSentinel}" Width="18" Height="18" Margin="0,0,12,0"/>
                                    <TextBlock Text="Sentinel" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Ellipse x:Name="SentinelDot" Width="6" Height="6" Fill="#FF6A6A"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         Visibility="{Binding HasActiveProblem, Converter={StaticResource BoolToVisibility}}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF6A6A" ShadowDepth="0" BlurRadius="6" Opacity="0.85"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Button>
                        <Button x:Name="NavDiagnosis" Tag="Diagnosis" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconDiagnosis}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Diagnosis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Tag="Settings" Click="NavButton_Click" Style="{StaticResource NavRail}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource IconSettings}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== CONTENT (caption strip + page host) ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Slim caption strip: drag region + window buttons -->
            <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinBtn" Click="MinimizeClick" Style="{StaticResource CaptionBtn}" ToolTip="Minimize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}">
                                        <Path Data="M 0,5 L 10,5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MaxBtn" Click="MaxRestoreClick" Style="{StaticResource CaptionBtn}" ToolTip="Maximize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10">
                                            <Path x:Name="MaxIcon" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Fill="Transparent"/>
                                            <Path x:Name="RestoreIcon" Visibility="Collapsed"
                                                  Data="M 2,2 L 10,2 L 10,10 M 0,4 L 8,4 L 8,12 L 0,12 Z"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" Fill="Transparent"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="CloseBtn" Click="CloseClick" Style="{StaticResource CaptionBtn}" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}">
                                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host — transparent so the window's dark tan-glow base shows here; the
                 frosted glass panels float on top of it. -->
            <Border Grid.Row="1" Background="Transparent">
                <ContentControl x:Name="PageHost" Margin="32,24,32,32"/>
            </Border>
        </Grid>
    </Grid>
</Window>
