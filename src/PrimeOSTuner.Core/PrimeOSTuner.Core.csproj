<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral core: models, stores, stats, protection logic, scanner/client
       INTERFACES. No Windows APIs — those live in PrimeOSTuner.Core.Windows (Windows-only
       concepts like registry tweaks) and PrimeOSTuner.Win (interop implementations).
       This split is what makes a macOS build possible. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Bloatware\catalog\bloatware-list.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Bloatware\catalog\desktop-bloatware-list.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="Education\guides\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
